
pipeline {
    // Run on the agent labelled 'docker' (agent1), keeping the controller free.
    agent { label 'docker' }

    // Start automatically when GitHub sends a push webhook.
    triggers {
        githubPush()
    }

    environment {
        // 'dockerhub' is the credential ID you create in Jenkins
        // (Manage Jenkins -> Credentials -> Username with password).
        // Jenkins splits it into DOCKERHUB_USR and DOCKERHUB_PSW.
        DOCKERHUB = credentials('dockerhub')

        // Image name = <your docker hub username>/eks-todo-backend
        IMAGE_NAME = "${DOCKERHUB_USR}/eks-todo-backend"

        // Tag with the short git commit + build number, so every image is unique.
        IMAGE_TAG  = "${GIT_COMMIT.take(7)}-${BUILD_NUMBER}"
    }

    options {
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build image') {
            when { changeset "backend/**" }
            steps {
                // Context is the repo root ('.'), same as your GitHub Actions setup.
                sh 'docker build -f backend/Dockerfile -t $IMAGE_NAME:$IMAGE_TAG -t $IMAGE_NAME:latest .'
            }
        }

        stage('Login to Docker Hub') {
            when { changeset "backend/**" }
            steps {
                // --password-stdin keeps the password out of the process list / logs.
                sh 'echo "$DOCKERHUB_PSW" | docker login -u "$DOCKERHUB_USR" --password-stdin'
            }
        }

        stage('Push image') {
            when { changeset "backend/**" }
            steps {
                sh 'docker push $IMAGE_NAME:$IMAGE_TAG'
                sh 'docker push $IMAGE_NAME:latest'
            }
        }
    }

    post {
        always {
            // Always log out and remove the local image to save disk on the EC2 box.
            sh 'docker logout || true'
            sh 'docker image rm $IMAGE_NAME:$IMAGE_TAG $IMAGE_NAME:latest || true'
        }
        success {
            echo "Pushed $IMAGE_NAME:$IMAGE_TAG and :latest to Docker Hub"
        }
        failure {
            echo 'Backend pipeline failed'
        }
    }
}

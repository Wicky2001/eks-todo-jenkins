// ============================================================
//  Jenkinsfile.deploy
//  1) Build + push only the services whose folder changed, to ECR,
//     tagged with the full git commit SHA (never 'latest').
//  2) Write the new tag into the Kubernetes manifests in the GitOps repo
//     (eks-todo-jenkins-gitops) and push it. Argo CD watches that repo
//     and deploys the change. This repo only holds the source code.
// ============================================================

pipeline {
    agent { label 'docker' }

    triggers {
        githubPush()
    }

    parameters {
        string(
            name: 'VITE_API_URL',
            defaultValue: '',
            trim: true,
            description: 'Base URL of the backend API, baked into the frontend build'
        )
    }

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '677501681528.dkr.ecr.us-east-1.amazonaws.com'

        // No AWS keys here. Jenkins runs on EC2, and the instance has an IAM role attached.
        // The AWS CLI finds no keys in the environment, so it asks the EC2 metadata service
        // (169.254.169.254) and gets temporary keys for that role, renewed automatically.

        // AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        // AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')

        // 'Username with password': GitHub username + a Personal Access Token.
        // Used to push the manifest change to the GitOps repo.
        GITHUB = credentials('github-eks-todo-jenkins-PAT')

        // The repo Argo CD watches. Only deploy commits go there.
        GITOPS_REPO = 'https://github.com/Wicky2001/eks-todo-jenkins-gitops.git'

        // Unique per commit, so every deploy is a real change Argo CD can detect.
        IMAGE_TAG = "${GIT_COMMIT}"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Debug: Check IAM role') {
            steps {
                sh 'aws sts get-caller-identity'
            }
        }


        stage('Login to ECR') {
            when {
                anyOf {
                    changeset "backend/**"
                    changeset "frontend/**"
                    changeset "migration/**"
                }
            }
            steps {
                // The AWS CLI uses the EC2 instance role's temporary keys,
                // gets a temporary ECR password and pipes it into 'docker login'.
                sh 'aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"'
            }
        }

        stage('Backend') {
            when { changeset "backend/**" }
            environment {
                IMAGE = "${ECR_REGISTRY}/eks-todo-backend:${IMAGE_TAG}"
            }
            steps {
                sh 'docker build -f backend/Dockerfile -t $IMAGE .'
                sh 'docker push $IMAGE'
                script { env.CHANGED_SERVICES = (env.CHANGED_SERVICES ?: '') + ' backend' }
            }
            post {
                always { sh 'docker image rm $IMAGE || true' }
            }
        }

        stage('Frontend') {
            when { changeset "frontend/**" }
            environment {
                IMAGE = "${ECR_REGISTRY}/eks-todo-frontend:${IMAGE_TAG}"
            }
            steps {
                sh '''
                    docker build \
                      -f frontend/Dockerfile \
                      --build-arg VITE_API_URL="$VITE_API_URL" \
                      -t $IMAGE \
                      .
                '''
                sh 'docker push $IMAGE'
                script { env.CHANGED_SERVICES = (env.CHANGED_SERVICES ?: '') + ' frontend' }
            }
            post {
                always { sh 'docker image rm $IMAGE || true' }
            }
        }

        stage('Migration') {
            when { changeset "migration/**" }
            environment {
                IMAGE = "${ECR_REGISTRY}/eks-todo-migration:${IMAGE_TAG}"
            }
            steps {
                sh 'docker build -f migration/Dockerfile -t $IMAGE .'
                sh 'docker push $IMAGE'
                script { env.CHANGED_SERVICES = (env.CHANGED_SERVICES ?: '') + ' migration' }
            }
            post {
                always { sh 'docker image rm $IMAGE || true' }
            }
        }

        stage('Update Kubernetes manifests') {
            when { expression { env.CHANGED_SERVICES != null } }
            steps {
                sh '''
                    # Fresh copy of the latest GitOps repo, so we never overwrite newer commits.
                    rm -rf gitops
                    git clone --depth 1 --branch main "$GITOPS_REPO" gitops
                    cd gitops

                    git config user.name "Jenkins"
                    git config user.email "jenkins@eks-todo.local"

                    # One commit per service, so it is easy to perform `git revert <commit>`. There for easy to rollback releases.
                    DEPLOY_DATE="$(date -u '+%Y-%m-%d %H:%M UTC')"

                    for svc in $CHANGED_SERVICES
                     do
                      case "$svc" in
                        backend)   
                            file=backend/deployment.yaml 
                            ;;
                        frontend)  
                            file=frontend/deployment.yaml 
                            ;;
                        migration) 
                            file=migration/migration-job.yaml 
                            ;;
                      esac

                      # sed -i "s|OLD|NEW" here s means substitution.
                      # replace the old image tag with new image tag.

                      sed -i "s|eks-todo-${svc}:.*|eks-todo-${svc}:${IMAGE_TAG}|" "$file"
                      git add "$file"

                      # SVC_UPPER="$(echo "$svc" | tr '[:lower:]' '[:upper:]')"
                      # convert the service name to Uppercase

                      SVC_UPPER="$(echo "$svc" | tr '[:lower:]' '[:upper:]')"

                      git commit -m "DEPLOY ${SVC_UPPER}---${DEPLOY_DATE} eks-todo-${svc}:${IMAGE_TAG}" \
                                 -m "Built from source commit ${IMAGE_TAG}."
                    done

                    # The helper hands git the token through the environment,
                    # so it never appears in the command line or the remote URL.
                    
                    CREDENTIAL_HELPER='
                    f() {
                        echo username=$GITHUB_USR
                        echo password=$GITHUB_PSW
                    }
                    f
                    '

                    # Push changes using the credential helper.
                    git -c credential.helper="$CREDENTIAL_HELPER" push origin main
                '''
            }
        }
    }

    post {
        always {
            sh 'docker logout "$ECR_REGISTRY" || true'
        }
        failure {
            echo 'Pipeline failed'
        }
    }
}

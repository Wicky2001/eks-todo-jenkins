// ============================================================
//  Jenkinsfile.deploy
//  1) Build + push only the services whose folder changed, to ECR,
//     tagged with the full git commit SHA (never 'latest').
//  2) Write the new tag into the Kubernetes manifests and push
//     that commit to main. Argo CD sees the change and deploys it.
// ============================================================

pipeline {
    agent { label 'docker' }

    triggers {
        githubPush()
    }

    parameters {
        string(
            name: 'VITE_API_BASE_URL',
            defaultValue: 'http://localhost:8081',
            description: 'Base URL of the backend API, baked into the frontend build'
        )
    }

    environment {
        AWS_REGION   = 'us-east-1'
        ECR_REGISTRY = '677501681528.dkr.ecr.us-east-1.amazonaws.com'

        // Two 'Secret text' credentials in Jenkins (keys of the eks-todo-jenkins IAM user).
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')

        // 'Username with password': GitHub username + a Personal Access Token.
        // Used to push the manifest change back to the repo.
        GITHUB = credentials('github-push')

        // Unique per commit, so every deploy is a real change Argo CD can detect.
        IMAGE_TAG = "${GIT_COMMIT}"
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Login to ECR') {
            when {
                anyOf {
                    changeset "backend/**"
                    changeset "frontend/**"
                    changeset "migration/**"
                }
            }
            steps {
                // The AWS CLI reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from the environment,
                // gets a temporary ECR password and pipes it into 'docker login'.
                sh 'aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$ECR_REGISTRY"'
            }
        }

        stage('Backend') {
            when { changeset "backend/**" }
            environment {
                IMAGE = "${ECR_REGISTRY}/eks-todo-backend:${IMAGE_TAG}"
            }
            steps {
                sh 'docker build -f backend/Dockerfile -t $IMAGE .'
                sh 'docker push $IMAGE'
                script { env.CHANGED_SERVICES = (env.CHANGED_SERVICES ?: '') + ' backend' }
            }
            post {
                always { sh 'docker image rm $IMAGE || true' }
            }
        }

        stage('Frontend') {
            when { changeset "frontend/**" }
            environment {
                IMAGE = "${ECR_REGISTRY}/eks-todo-frontend:${IMAGE_TAG}"
            }
            steps {
                sh '''
                    docker build \
                      -f frontend/Dockerfile \
                      --build-arg VITE_API_BASE_URL="$VITE_API_BASE_URL" \
                      -t $IMAGE \
                      .
                '''
                sh 'docker push $IMAGE'
                script { env.CHANGED_SERVICES = (env.CHANGED_SERVICES ?: '') + ' frontend' }
            }
            post {
                always { sh 'docker image rm $IMAGE || true' }
            }
        }

        stage('Migration') {
            when { changeset "migration/**" }
            environment {
                IMAGE = "${ECR_REGISTRY}/eks-todo-migration:${IMAGE_TAG}"
            }
            steps {
                sh 'docker build -f migration/Dockerfile -t $IMAGE .'
                sh 'docker push $IMAGE'
                script { env.CHANGED_SERVICES = (env.CHANGED_SERVICES ?: '') + ' migration' }
            }
            post {
                always { sh 'docker image rm $IMAGE || true' }
            }
        }

        stage('Update Kubernetes manifests') {
            when { expression { env.CHANGED_SERVICES != null } }
            steps {
                sh '''
                    git config user.name "Jenkins"
                    git config user.email "jenkins@eks-todo.local"

                    # Start from the latest main, so we never overwrite newer commits.
                    git fetch origin main
                    git checkout -B main FETCH_HEAD

                    for svc in $CHANGED_SERVICES; do
                      case "$svc" in
                        backend)   file=k8s/app/backend/deployment.yaml ;;
                        frontend)  file=k8s/app/frontend/deployment.yaml ;;
                        migration) file=k8s/app/migration/migration-job.yaml ;;
                      esac
                      # Replace the old tag after 'eks-todo-<svc>:' with the new one.
                      sed -i "s|eks-todo-${svc}:[^\\"[:space:]]*|eks-todo-${svc}:${IMAGE_TAG}|" "$file"
                      git add "$file"
                    done

                    git commit -m "deploy:${CHANGED_SERVICES} -> ${IMAGE_TAG}"

                    # The helper hands git the token through the environment,
                    # so it never appears in the command line or the remote URL.
                    git -c credential.helper='!f() { echo username=$GITHUB_USR; echo password=$GITHUB_PSW; }; f' \
                      push origin main
                '''
            }
        }
    }

    post {
        always {
            sh 'docker logout "$ECR_REGISTRY" || true'
        }
        failure {
            echo 'Pipeline failed'
        }
    }
}

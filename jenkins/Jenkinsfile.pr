

pipeline {
    agent { label 'docker' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        IMG_TAG = "pr-${env.CHANGE_ID ?: env.BRANCH_NAME}-${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // Fails the PR if any commit in it adds a secret. gitleaks is installed in the
        // agent image (jenkins/images/Dockerfile.agent). "gitleaks git" reads what each
        // commit added; --log-opts limits it to the commits that are in this PR but not
        // yet in the target branch. Known old findings are listed in .gitleaksignore.
        stage('Secret scan (gitleaks)') {
            steps {
                sh '''
                    TARGET="${CHANGE_TARGET:-main}"
                    git fetch --no-tags origin "+refs/heads/${TARGET}:refs/remotes/origin/${TARGET}"
                    gitleaks git . \
                      --log-opts="origin/${TARGET}..HEAD" \
                      --redact --no-banner \
                      --report-format sarif --report-path gitleaks-report.sarif
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'gitleaks-report.sarif', allowEmptyArchive: true
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {

                withSonarQubeEnv('SonarCloud') {
                    sh '''
                        docker run --rm \
                          -e SONAR_HOST_URL="$SONAR_HOST_URL" \
                          -e SONAR_TOKEN="$SONAR_AUTH_TOKEN" \
                          -v "$PWD:/usr/src" \
                          sonarsource/sonar-scanner-cli
                    '''
                }
            }
        }

        stage('Build backend image') {
            steps {
                sh 'docker build -f backend/Dockerfile -t eks-todo-backend:$IMG_TAG .'
            }
        }

        stage('Build frontend image') {
            steps {
                sh 'docker build -f frontend/Dockerfile --build-arg VITE_API_URL="" -t eks-todo-frontend:$IMG_TAG .'
            }
        }

        stage('Build migration image') {
            steps {
                sh 'docker build -f migration/Dockerfile -t eks-todo-migration:$IMG_TAG .'
            }
        }
    }

    post {
        always {
            sh 'docker image rm eks-todo-backend:$IMG_TAG eks-todo-frontend:$IMG_TAG eks-todo-migration:$IMG_TAG || true'
        }
    }
}

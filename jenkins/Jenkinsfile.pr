

pipeline {
    agent { label 'docker' }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        IMG_TAG = "pr-${env.CHANGE_ID ?: env.BRANCH_NAME}-${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('SonarCloud Analysis') {
            steps {

                withSonarQubeEnv('SonarCloud') {
                    sh '''
                        docker run --rm \
                          -e SONAR_HOST_URL="$SONAR_HOST_URL" \
                          -e SONAR_TOKEN="$SONAR_AUTH_TOKEN" \
                          -v "$PWD:/usr/src" \
                          sonarsource/sonar-scanner-cli
                    '''
                }
            }
        }

        stage('Build backend image') {
            steps {
                sh 'docker build -f backend/Dockerfile -t eks-todo-backend:$IMG_TAG .'
            }
        }

        stage('Build frontend image') {
            steps {
                sh 'docker build -f frontend/Dockerfile --build-arg VITE_API_URL="" -t eks-todo-frontend:$IMG_TAG .'
            }
        }

        stage('Build migration image') {
            steps {
                sh 'docker build -f migration/Dockerfile -t eks-todo-migration:$IMG_TAG .'
            }
        }
    }

    post {
        always {
            sh 'docker image rm eks-todo-backend:$IMG_TAG eks-todo-frontend:$IMG_TAG eks-todo-migration:$IMG_TAG || true'
        }
    }
}
